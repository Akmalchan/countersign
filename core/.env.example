# Copy to core/.env and fill in. core/.env is git-ignored and never leaves this Mac.
# Gmail connector (IMAP). Create an app password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). Paste it here yourself; don't share it in chat.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Optional: cap on live-data spend per server run (USD)
# COUNTERSIGN_BUDGET_USD=1

# AI callback (Vapi: dashboard.vapi.ai, then API Keys + Phone Numbers)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Demo only: every verification call rings this number instead (E.164, e.g. +14155550123)
CALL_DEMO_TO=
COMPANY_NAME=Blaze
